+            // Stripped ELFs often reach SDK routines only via tail-call J (or not at all), so
+            // function discovery never creates them. A configured "name@addr" stub with a
+            // resolved runtime handler must still get a wrapper, or dispatch to it fails.
+            {
+                std::unordered_set<uint32_t> knownStarts;
+                for (const auto &function : m_functions)
+                    knownStarts.insert(function.start);
+                size_t synthesized = 0;
+                for (const auto &[start, handler] : m_stubHandlerBindingsByStart)
+                {
+                    if (knownStarts.contains(start) || handler.empty() ||
+                        resolveStubTarget(handler) == StubTarget::Unknown)
+                        continue;
+                    Function stub{};
+                    stub.name = handler;
+                    stub.start = start;
+                    stub.end = start + 4u;
+                    m_functions.push_back(std::move(stub));
+                    ++synthesized;
+                }
+                if (synthesized > 0)
+                {
+                    std::ostringstream msg;
+                    msg << "synthesized " << synthesized << " undiscovered stub function(s) from config";
+                    m_reporter.progress(msg.str());
+                }
+            }
+
             for (auto &function : m_functions)
