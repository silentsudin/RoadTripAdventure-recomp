#include <winuser.h>

// The manifest (UTF-8 code page, long paths, per-monitor DPI).
1 RT_MANIFEST "RoadTrip.manifest"

#define RT_VER @RT_VERSION_MAJOR@,@RT_VERSION_MINOR@,@RT_VERSION_PATCH@,0
1 VERSIONINFO
FILEVERSION RT_VER
PRODUCTVERSION RT_VER
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Road Trip Recomp"
      VALUE "ProductName", "Road Trip Recomp"
      VALUE "ProductVersion", "@RT_VERSION@"
      VALUE "FileVersion", "@RT_VERSION@"
      VALUE "OriginalFilename", "RoadTrip.exe"
      VALUE "LegalCopyright", "GPL-3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
@RT_ICON_LINE@
